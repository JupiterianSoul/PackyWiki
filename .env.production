# The Supabase project this app talks to.
#
# Committed on purpose. Both values below are public by design: they identify
# the project, not the player, and they are compiled into the bundle and ship
# inside every APK, which is itself a public download from this repository.
# Anyone who could read them here could already unzip them out of the APK.
#
# What actually keeps one player out of another's data is the row-level
# security in supabase/schema.sql. Nothing here is a password.
#
# The SECRET key (sb_secret_...) bypasses every one of those rules. It is not
# used by this app, it must never be added to this file, and it must never
# leave the Supabase dashboard.

VITE_SUPABASE_URL=https://lfcehzltokzaymnqodgh.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable__SnC0LIUS9u7DjR4eomG8w_FtILhz4R
