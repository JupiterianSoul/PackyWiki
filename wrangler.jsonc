// Cloudflare: the website is the built folder, served as static assets, with
// no Worker code in front of it. Cloudflare's Git integration reads this so
// it does not try to auto-configure the Vite project itself. Build command:
// `npm run build`; deploy command: `npx wrangler deploy`.
{
  "name": "wiklodo",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
